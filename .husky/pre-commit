#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E "\.(js|ts)$") || true

if [ -n "$STAGED_FILES" ]; then
  if echo "$STAGED_FILES" | xargs grep -l "console.log" 2>/dev/null; then
    echo "Found console.log statements. Please remove before committing."
    exit 1
  fi

  if echo "$STAGED_FILES" | xargs grep -l "debugger" 2>/dev/null; then
    echo "Found debugger statements. Please remove before committing."
    exit 1
  fi
fi

echo "Pre-commit checks passed!"
